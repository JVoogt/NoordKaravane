---
// Lift kit price block: the price, then the specs as a ruled table, ending in the page's one primary CTA.
// The price comes from pricing.ts. The photo of the fitted kit is the page's hero photo.
import { ADDONS, fmtR } from '../data/pricing';
import { servicePath } from '../data/routes';
import CtaButton from './CtaButton.astro';

interface Props {
  /** The page's own wa.me link and button label (same as the hero CTA). */
  href: string;
  label: string;
}
const { href, label } = Astro.props;

const price = ADDONS.find((a) => a.id === 'lift-kit')!.price;
const specs = [
  { k: 'Lift height', v: '50 mm' },
  { k: 'Fit time', v: 'About 1 day' },
  { k: 'Warranty', v: '12 months' },
  { k: 'Fitment', v: 'Most models' },
];
---

<section id="lift-kit" class="sec">
  <div class="wrap kit">
    <div>
      <h2>50 mm lift kit: price, fit time and warranty</h2>
      <div class="kit-price">
        <span class="amt nums">{fmtR(price)}</span>
        <span class="unit">Fitted, taxes included</span>
      </div>
      <p class="kit-sub">Booking a <a class="link" href={servicePath('caravan-service') + '#pricing'}>caravan service</a> anyway? Tick the lift kit as an add-on in the estimate and we fit both in one visit.</p>
    </div>
    <div>
      <dl class="specs nums">
        {specs.map((s) => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
      </dl>
      <CtaButton href={href} variant="primary" icon="wa" external>{label}</CtaButton>
    </div>
  </div>
</section>
