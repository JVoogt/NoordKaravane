---
// Lift kit price block. The price comes from pricing.ts; the block ends in the page's one primary CTA.
import { Picture } from 'astro:assets';
import liftKit from '../assets/lift-kit.jpg';
import { ADDONS, fmtR } from '../data/pricing';
import { servicePath } from '../data/routes';
import CtaButton from './CtaButton.astro';

interface Props {
  /** The page's own wa.me link and button label (same as the hero CTA). */
  href: string;
  label: string;
}
const { href, label } = Astro.props;

const price = ADDONS.find((a) => a.id === 'lift-kit')!.price;
const specs = [
  { k: 'Lift height', v: '50 mm' },
  { k: 'Fit time', v: 'About 1 day' },
  { k: 'Warranty', v: '12 months' },
  { k: 'Fitment', v: 'Most models' },
];
---

<section id="lift-kit" class="block">
  <div class="container">
    <div class="promo">
      <div class="promo-media">
        <Picture
          src={liftKit}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 640, 900]}
          sizes="(max-width: 1100px) 92vw, 560px"
          quality={70}
          alt="Jurgens Penta with a 50 mm lift kit fitted at Noord Karavane"
          loading="lazy"
          decoding="async"
        />
        <span class="promo-ticket">Fitted at our workshop</span>
      </div>
      <div class="promo-detail">
        <h2 class="promo-title">50 mm lift kit: price, fit time and warranty</h2>
        <div class="promo-price">
          <span class="amt">{fmtR(price)}</span>
          <span class="unit">Fitted, taxes included</span>
        </div>
        <p class="promo-sub">Booking a <a href={servicePath('caravan-service') + '#pricing'}>caravan service</a> anyway? Tick the lift kit as an add-on in the estimate and we fit both in one visit.</p>
        <dl class="promo-specs">
          {specs.map((s) => <div class="promo-spec"><dt class="k">{s.k}</dt><dd class="v">{s.v}</dd></div>)}
        </dl>
        <CtaButton href={href} variant="primary" external>{label}</CtaButton>
      </div>
    </div>
  </div>
</section>
