---
// The top line above the nav. Static text only: the workshop hours, the address and the number. It makes no live
// "open now" claim: the weekly hours know nothing about public holidays or other closures.
import { BUSINESS } from '../data/business';
import { formatHoursCompact } from '../lib/hours';

interface Props {
  /** Recoveries page: one static line that says recoveries run 24/7 and dials the number. No workshop hours here,
      so a stranded visitor never reads "closed" first. */
  emergency?: boolean;
}
const { emergency = false } = Astro.props;
const a = BUSINESS.address;
const tel = `tel:${BUSINESS.phone.e164}`;
---

{emergency ? (
  <div class="topbar topbar--emergency">
    <a class="topbar-call" href={tel}>{`${BUSINESS.recoveriesNote} · Call ${BUSINESS.phone.display}`}</a>
  </div>
) : (
  <div class="topbar nums">
    {/* The number is a link above 860px. At 860px and below it is plain text: a 17px line of text is no tap target,
        and the fixed bar at the bottom of the screen carries Call there. Same words either way: the plain-text
        twin draws the number from data-tel (chrome.css), so the markup holds it once. */}
    <div class="wrap topbar-track">
      <span>{formatHoursCompact(BUSINESS.hours)}</span>{' '}
      <span class="topbar-addr">Caravan workshop, <a href="/find-us/">{a.street}, {a.locality}</a></span>{' '}
      <span>WhatsApp or call <a class="topbar-tel" href={tel}>{BUSINESS.phone.display}</a><span class="topbar-tel-text" data-tel={BUSINESS.phone.display}></span></span>
    </div>
  </div>
)}
