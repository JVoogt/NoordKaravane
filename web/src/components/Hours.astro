---
// Workshop hours, one line per day group. The recoveries line is not part of this block: where recoveries are the
// subject, ContactBand shows "Recoveries 24/7" as its own labelled item, so "closed" never reads as recoveries.
import { BUSINESS } from '../data/business';
import { formatHoursLines } from '../lib/hours';

const lines = formatHoursLines(BUSINESS.hours);
---

<div class="loc-v">
  {lines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
</div>
