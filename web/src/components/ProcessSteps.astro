---
// Five-step workshop process on the Caravan service page, in the Home page's numbered steps (the numerals are a
// CSS counter on the ordered list). A real sequence, so it stays an ordered list.
const steps = [
  { h: 'Message us', p: "WhatsApp the make, year and what's bothering you. Photos help." },
  { h: 'Inspection', p: 'A walk-around when it arrives: brakes, bearings, tyres, electrics and structure, logged with photos.' },
  { h: 'Quote', p: 'A plain-language quote before any work starts.' },
  { h: 'The work', p: 'Done in our workshop. If we find something new on the way, we message you before going further.' },
  { h: 'Sign-off', p: "A last road-ready check and a written report in your service book. Then she's ready to collect." },
];
---

<section id="process" class="sec">
  <div class="wrap sec-split">
    <div class="sec-head">
      <h2>How a caravan service works</h2>
    </div>
    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <div>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
