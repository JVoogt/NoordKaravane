---
// Five-step workshop process on the Caravan service page. A real sequence, so the step numbers stay.
const steps = [
  { h: 'Message us', p: "WhatsApp the make, year and what's bothering you. Photos help. We book you a slot, usually within the week." },
  { h: 'Inspection', p: 'A walk-around when it arrives: brakes, bearings, tyres, electrics and structure, logged with photos.' },
  { h: 'Quote', p: 'A plain-language quote before any work starts. Optional extras are listed on their own, so you can say no to them.' },
  { h: 'The work', p: 'Done in our workshop. If we find something new on the way, we message you before going further.' },
  { h: 'Sign-off', p: "A last road-ready check and a written report in your service book. Then she's ready to collect." },
];
---

<section id="process" class="block">
  <div class="container">
    <div class="sec-head">
      <h2 class="sec-title">How a caravan service works</h2>
    </div>

    <ol class="process">
      {steps.map((s, i) => (
        <li class="step">
          <div class="step-dot" aria-hidden="true">{i + 1}</div>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
