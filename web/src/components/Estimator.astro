---
// Works without JS: a static add-on list plus a CTA whose href is baked at build time as a NEUTRAL enquiry (nobody
// has picked a package yet). With JS (html.js) the live controls replace the list and scripts/estimator.ts
// rewrites the total and the CTA href with the real estimate on load and on every change.
import { ADDONS, AXLE_OPTIONS, fmtR } from '../data/pricing';
import { DEFAULT_AXLE, estimate, neutralEstimateUrl } from '../lib/estimator';

const base = estimate(DEFAULT_AXLE, []);
const addonPrice = (price: number): string => (price ? `+ ${fmtR(price)}` : 'POA');
---

<div class="estimator" data-estimator>
  <h3>Estimate in 30 seconds</h3>
  <p><span class="est-live-only">Pick your axle setup and any extras. </span>We'll send you a pre-filled WhatsApp.</p>

  <div class="est-static">
    <div class="est-field">
      <div class="est-label">Add-ons</div>
      <ul class="est-static-list">
        {ADDONS.map((a) => (
          <li><span>{a.label}</span><span class="est-chk-price">{addonPrice(a.price)}</span></li>
        ))}
      </ul>
    </div>
    <div class="est-total-note">Parts are extra and VAT is included. Nothing extra gets done without your go-ahead.</div>
  </div>

  <div class="est-live">
    <div class="est-field" role="group" aria-labelledby="est-axle-label">
      <div class="est-label" id="est-axle-label">Axle configuration</div>
      <div class="est-opts">
        {AXLE_OPTIONS.map((o) => (
          <button type="button" class="est-opt" data-axle={o.id} aria-pressed={o.id === DEFAULT_AXLE ? 'true' : 'false'}>{o.label}</button>
        ))}
      </div>
    </div>

    <div class="est-field" role="group" aria-labelledby="est-addons-label">
      <div class="est-label" id="est-addons-label">Add-ons</div>
      <div class="est-checks">
        {ADDONS.map((a) => (
          <button type="button" class="est-chk" data-addon={a.id} aria-pressed="false">
            <span class="est-chk-left"><span class="box" aria-hidden="true"></span>{a.label}</span>
            <span class="est-chk-price">{addonPrice(a.price)}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="est-total">
      <div>
        <div class="est-total-label">Estimated total</div>
        <div class="est-total-note">Parts are extra and VAT is included. Nothing extra gets done without your go-ahead.</div>
      </div>
      <div class="est-total-amt" data-est-total aria-live="polite">{base.totalLabel}</div>
    </div>
  </div>

  <a href={neutralEstimateUrl()} class="btn btn-whatsapp est-cta" data-est-cta target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.55 2 2.08 6.46 2.08 11.95c0 1.76.46 3.47 1.33 4.98L2 22l5.2-1.36a9.9 9.9 0 0 0 4.84 1.23h.01c5.49 0 9.95-4.46 9.95-9.95A9.93 9.93 0 0 0 12.04 2zm0 18.2h-.01a8.25 8.25 0 0 1-4.2-1.15l-.3-.18-3.09.81.83-3.01-.2-.31a8.23 8.23 0 0 1-1.26-4.4c0-4.56 3.71-8.27 8.28-8.27a8.27 8.27 0 0 1 8.27 8.27c0 4.56-3.71 8.24-8.32 8.24zm4.54-6.19c-.25-.12-1.47-.72-1.7-.8-.23-.09-.39-.13-.56.12-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
    WhatsApp my estimate
  </a>
</div>

<script>
  import '../scripts/estimator';
</script>
