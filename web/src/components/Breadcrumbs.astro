---
interface Props {
  items: Array<{ name: string; path: string }>;
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>
        {i === items.length - 1
          ? <span aria-current="page">{it.name}</span>
          : <a href={it.path}>{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
