---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { BUSINESS } from '../data/business';
import { servicePath } from '../data/routes';
import { waUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';
import QuickNav from './QuickNav.astro';

interface Props {
  path: string;
  waText: string;
}
const { path, waText } = Astro.props;

// Someone who has broken down is not browsing or booking: on Recoveries the header and the chip row are about
// reaching us. The Call button becomes the filled primary action (it stays in the header at every width),
// WhatsApp sits beside it as the second choice, and the chips jump to what to send and where we recover instead
// of Pricing and Shop. Everywhere else the header shows the number as a link and the WhatsApp booking button;
// below 861px the number moves to the fixed bar at the bottom of the screen (Base.astro).
const emergency = path === servicePath('recoveries');
const raw = [
  { label: 'Services', href: '/#services' },
  { label: 'Recoveries', href: servicePath('recoveries') },
  { label: 'Pricing', href: servicePath('caravan-service') + '#pricing' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Find us', href: '/find-us/' },
];
// aria-current only for a link that points at this very page (no hash, same path).
const links = raw.map((l) => ({ ...l, current: !l.href.includes('#') && l.href === path }));
const chips = emergency
  ? [
      { label: 'Call', href: `tel:${BUSINESS.phone.e164}`, current: false },
      { label: 'WhatsApp', href: waUrl(waText), current: false, external: true },
      { label: 'What to send', href: '#what-to-send', current: false },
      { label: 'Service area', href: '#service-area', current: false },
    ]
  : links;
const tel = `tel:${BUSINESS.phone.e164}`;
---

<nav class:list={['nav', { 'nav--emergency': emergency }]} aria-label="Main">
  <div class="wrap nav-inner">
    <a href="/" class="brand">
      <Image src={logo} width={88} height={88} format="webp" alt={BUSINESS.name} loading="eager" />
      <b aria-hidden="true">{BUSINESS.name}</b>
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </div>
    {/* The accessible name contains the visible words (the number, or "Call"), so voice control can find the link. */}
    <a href={tel} class:list={['nav-call', 'nums', { 'nav-call--primary': emergency }]} aria-label={`Call ${BUSINESS.name} on ${BUSINESS.phone.display}`}>
      {emergency ? <Fragment><Icon name="tel" /><span>Call</span></Fragment> : BUSINESS.phone.display}
    </a>
    <a href={waUrl(waText)} class:list={['nav-cta', { 'nav-cta--second': emergency }]} target="_blank" rel="noopener">
      <Icon name="wa" /><span>{emergency ? 'WhatsApp' : 'Book on WhatsApp'}</span>
    </a>
  </div>
  <QuickNav links={chips} />
</nav>
