---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { BUSINESS } from '../data/business';
import { servicePath } from '../data/routes';
import { waUrl } from '../lib/whatsapp';
import QuickNav from './QuickNav.astro';

interface Props {
  path: string;
  waText: string;
}
const { path, waText } = Astro.props;

const raw = [
  { label: 'Services', href: '/#services' },
  { label: 'Recoveries', href: servicePath('recoveries') },
  { label: 'Pricing', href: servicePath('caravan-service') + '#pricing' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Find us', href: '/find-us/' },
];
// aria-current only for a link that points at this very page (no hash, same path).
const links = raw.map((l) => ({ ...l, current: !l.href.includes('#') && l.href === path }));
---

<nav class="nav" aria-label="Main">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <span class="brand-mark"><Image src={logo} width={68} height={68} format="webp" alt="Noord Karavane" loading="eager" /></span>
      <span class="brand-txt">{BUSINESS.name}<small>{BUSINESS.address.locality}</small></span>
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </div>
    <div class="nav-cta-group">
      <a href={`tel:${BUSINESS.phone.e164}`} class="nav-phone" aria-label={`Call ${BUSINESS.phone.display}`}>{BUSINESS.phone.display}</a>
      <a href={waUrl(waText)} class="nav-cta" target="_blank" rel="noopener">
        Book on WhatsApp
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
  <QuickNav links={links} />
</nav>
