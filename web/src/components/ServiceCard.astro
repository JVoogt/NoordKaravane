---
// One service as a link row: the visitor's problem first (in their words), then what the work covers and the price tag.
import type { ServiceSlug } from '../data/routes';
import { servicePath } from '../data/routes';
import { serviceMeta } from '../data/services';

interface Props {
  slug: ServiceSlug;
  /** Related-services cards: problem line, name and tag only (no blurb). */
  compact?: boolean;
}
const { slug, compact = false } = Astro.props;
const meta = serviceMeta(slug);
---

<a class:list={['svc', { 'svc--compact': compact }]} href={servicePath(slug)}>
  <p class="svc-need">{meta.need}</p>
  <h3>{meta.name}</h3>
  {!compact && <p class="svc-blurb">{meta.blurb}</p>}
  <div class="svc-foot">
    <span>{meta.tag}</span>
    <span class="arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
