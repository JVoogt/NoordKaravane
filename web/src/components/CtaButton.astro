---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'whatsapp';
  external?: boolean;
}
const { href, variant = 'primary', external = false } = Astro.props;
---

<a
  href={href}
  class={`btn btn-${variant}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
</a>
