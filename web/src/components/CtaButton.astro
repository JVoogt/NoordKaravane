---
import Icon from './Icon.astro';

interface Props {
  href: string;
  /** primary: the filled action. ghost: the outlined second choice. Both take their colours from the section they sit in. */
  variant?: 'primary' | 'ghost';
  external?: boolean;
  /** Optional icon before the label. */
  icon?: 'wa' | 'tel';
}
const { href, variant = 'primary', external = false, icon } = Astro.props;
---

<a
  href={href}
  class={`btn btn-${variant}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  {icon && <Icon name={icon} />}<slot />
</a>
