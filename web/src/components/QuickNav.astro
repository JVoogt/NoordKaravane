---
import { BUSINESS } from '../data/business';

interface Props {
  links: Array<{ label: string; href: string; current: boolean }>;
}
const { links } = Astro.props;
---

<div class="mobile-quicknav">
  <a href={`tel:${BUSINESS.phone.e164}`}>Call</a>
  {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
</div>

<script>
  // Enhancement only: the right-edge fade is on by default (no JS needed to see that the row scrolls)
  // and is switched off once the row is scrolled to its end (or when nothing is left to scroll to).
  const row = document.querySelector<HTMLElement>('.mobile-quicknav');
  if (row) {
    const sync = () => {
      const gutter = parseFloat(getComputedStyle(row).paddingRight) || 0;
      const remaining = row.scrollWidth - row.clientWidth - row.scrollLeft;
      row.toggleAttribute('data-end', remaining <= gutter + 1);
    };
    row.addEventListener('scroll', sync, { passive: true });
    // Chrome does not scroll a half-visible chip fully into view on focus; do it so Tab never lands under the fade.
    row.addEventListener('focusin', (e) => {
      (e.target as HTMLElement).scrollIntoView({ block: 'nearest', inline: 'nearest' });
    });
    window.addEventListener('resize', sync);
    // The web font changes chip widths after the first sync: measure again once fonts are in, and whenever the
    // row or a chip changes size, so the fade is never left on over a fully visible last chip.
    document.fonts?.ready.then(sync);
    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(sync);
      ro.observe(row);
      [...row.children].forEach((chip) => ro.observe(chip));
    }
    sync();

    // The sticky header costs ~128px on a phone: the chip row slides away on scroll down and returns on scroll up,
    // near the top of the page, on any Tab press and whenever focus is inside the header. Without JS it never hides.
    const nav = row.closest<HTMLElement>('.nav');
    if (nav) {
      let lastY = window.scrollY;
      let tabAt = -Infinity; // a scroll caused by Tab moving focus must not hide the row again
      const setHidden = (hide: boolean) => nav.toggleAttribute('data-qn-hidden', hide);
      window.addEventListener(
        'scroll',
        () => {
          const y = window.scrollY;
          const dy = y - lastY;
          if (y < 80 || dy < -4) setHidden(false);
          else if (dy > 4 && performance.now() - tabAt > 800 && !nav.contains(document.activeElement)) setHidden(true);
          lastY = y;
        },
        { passive: true },
      );
      nav.addEventListener('focusin', () => setHidden(false));
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        tabAt = performance.now();
        setHidden(false);
      });
    }
  }
</script>
