---
// Closing band: the last section of every page but Home. An ink field with the WhatsApp and Call actions and,
// beside them, the workshop address and hours as a ruled list. waText keeps each page's own WhatsApp message;
// heading and text let a page say what to send. The .contact hook and both links are what verify check 14 reads.
import CtaButton from './CtaButton.astro';
import { BUSINESS } from '../data/business';
import { formatHoursRows } from '../lib/hours';
import { WA_TEXT, waUrl } from '../lib/whatsapp';

interface Props {
  id?: string;
  heading?: string;
  text?: string;
  waText?: string;
  /** Where the location column's button goes: the Find us page, or none (Find us itself already shows it all). */
  place?: 'find-us' | 'none';
  /** Label for the Find us button. */
  placeLabel?: string;
  /** Add the recoveries line under the workshop hours (Recoveries page). */
  recoveries?: boolean;
  /** Emergency page: Call first and filled, WhatsApp beside it as the outlined second choice (matches the hero). */
  callFirst?: boolean;
}
const {
  id = 'contact',
  heading = 'Book a slot or ask a question',
  text = "Send the make, year and what's going on. If you don't know what the part is called, a photo does the job.",
  waText = WA_TEXT.enquire,
  place = 'find-us',
  placeLabel = 'Find us',
  recoveries = false,
  callFirst = false,
} = Astro.props;
const a = BUSINESS.address;
const tel = `tel:${BUSINESS.phone.e164}`;
---

<section class="sec band on-ink" id={id}>
  <div class="wrap">
    <div class:list={['contact', { 'contact--solo': place === 'none' }]}>
      <div class="contact-main">
        <h2>{heading}</h2>
        <p class="contact-text">{text}</p>
        <div class="cta-row contact-actions">
          {callFirst ? (
            <Fragment>
              <CtaButton href={tel} variant="primary" icon="tel">Call {BUSINESS.phone.display}</CtaButton>
              <CtaButton href={waUrl(waText)} variant="ghost" icon="wa" external>WhatsApp {BUSINESS.phone.display}</CtaButton>
            </Fragment>
          ) : (
            <Fragment>
              <CtaButton href={waUrl(waText)} variant="primary" icon="wa" external>WhatsApp {BUSINESS.phone.display}</CtaButton>
              <CtaButton href={tel} variant="ghost" icon="tel">Call {BUSINESS.phone.display}</CtaButton>
            </Fragment>
          )}
        </div>
        <slot />
      </div>
      {place !== 'none' && (
        <div class="band-loc">
          <dl class="find-facts nums">
            <div>
              <dt>Workshop</dt>
              <dd>{a.street}<span class="sr-only">, </span><small>{a.locality}, {a.city}, {a.postalCode}</small></dd>
            </div>
            <div>
              <dt>Workshop hours</dt>
              <dd class="hrs">
                {formatHoursRows(BUSINESS.hours).map((r) => <Fragment><span>{r.days}</span>{' '}<span>{r.time}</span>{' '}</Fragment>)}
              </dd>
            </div>
            {recoveries && (
              <div>
                <dt>{BUSINESS.recoveriesNote}</dt>
                <dd><a class="find-tel" href={tel}>Call {BUSINESS.phone.display}</a></dd>
              </div>
            )}
          </dl>
          <CtaButton href="/find-us/" variant="ghost">{placeLabel}</CtaButton>
        </div>
      )}
    </div>
  </div>
</section>
