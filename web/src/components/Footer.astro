---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { BUSINESS } from '../data/business';
import { servicePath } from '../data/routes';
import { SERVICE_LIST } from '../data/services';
import { formatHoursSegments } from '../lib/hours';
import { waUrl } from '../lib/whatsapp';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="tread" aria-hidden="true"></div>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="brand">
          <Image src={logo} width={88} height={88} format="webp" alt={BUSINESS.name} />
          <b aria-hidden="true">{BUSINESS.name}</b>
        </a>
        <p>A small caravan and trailer workshop in {BUSINESS.address.locality}: servicing, repairs, electrical and solar, lift kits and recoveries.</p>
      </div>
      <div class="foot-col">
        <h3 class="foot-heading">Workshop</h3>
        <ul>
          {SERVICE_LIST.map((s) => <li><a href={servicePath(s.slug)}>{s.name}</a></li>)}
        </ul>
      </div>
      <div class="foot-col">
        <h3 class="foot-heading">Company</h3>
        <ul>
          <li><a href="/find-us/">Find us</a></li>
          <li><a href={BUSINESS.links.kampi} target="_blank" rel="noopener">Kampi rentals</a></li>
          <li><a href="/shop/">Shop</a></li>
        </ul>
      </div>
      <div class="foot-col nums">
        <h3 class="foot-heading">Contact</h3>
        <ul>
          <li><a href={waUrl()} target="_blank" rel="noopener">WhatsApp {BUSINESS.phone.display}</a></li>
          <li><a href={`tel:${BUSINESS.phone.e164}`}>Call {BUSINESS.phone.display}</a></li>
          <li><a href="/find-us/">{BUSINESS.address.street}</a></li>
          {formatHoursSegments(BUSINESS.hours).map((seg) => <li><a href="/find-us/"><span class="foot-hours-seg">{seg}</span></a></li>)}
        </ul>
      </div>
    </div>
    <div class="foot-end">
      <span>&copy; {year} {BUSINESS.name}, {BUSINESS.address.locality}, South Africa</span>
      <span>Road-ready from {BUSINESS.address.locality}</span>
    </div>
  </div>
</footer>
