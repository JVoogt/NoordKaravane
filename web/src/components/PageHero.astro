---
// The hero of every page but Home: the ink field, quiet breadcrumbs, the headline in two tones, then whatever the
// page puts under it (lede, actions, facts). The second column is a photo that runs to the right edge, or a block
// the page supplies (slot "side"), or nothing.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import '../styles/pages.css';
import { splitHeadline } from '../lib/headline';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  /** The headline. A string is split into its two lines by splitHeadline; a pair sets the lines by hand. */
  h1: string | [string, string];
  crumbs?: Array<{ name: string; path: string }>;
  photo?: {
    src: ImageMetadata;
    alt: string;
    /** object-position of the crop, when the subject is off centre. */
    position?: string;
    /** A short caption set on the photo. */
    caption?: string;
  };
  /** The page fills the second column itself (slot "side"). A prop, because Astro reports a slot as present even
      when its only child is a false conditional. */
  side?: boolean;
  class?: string;
}
const { h1, crumbs, photo, side = false, class: className } = Astro.props;
const [first, second] = typeof h1 === 'string' ? splitHeadline(h1) : h1;
---

<header class:list={['hero', 'hero--page', 'on-ink', { 'hero--solo': !photo && !side }, className]}>
  <div class="hero-in">
    <div class="hero-copy">
      <div class="hero-text">
        {crumbs && <Breadcrumbs items={crumbs} />}
        <h1 class="h1-page">
          {second ? <Fragment><span>{first}</span>{' '}<span class="hi">{second}</span></Fragment> : first}
        </h1>
        <slot />
      </div>
    </div>
    {photo && (
      <div class="hero-photo">
        <Picture
          src={photo.src}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 860, 1100]}
          sizes="(max-width: 860px) 100vw, 44vw"
          quality={62}
          alt={photo.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style={photo.position ? `object-position: ${photo.position}` : undefined}
        />
        {photo.caption && <p class="hero-cap">{photo.caption}</p>}
      </div>
    )}
    {side && (
      <div class="hero-side">
        <div class="hero-side-in"><slot name="side" /></div>
      </div>
    )}
  </div>
  <div class="tread" aria-hidden="true"></div>
</header>
