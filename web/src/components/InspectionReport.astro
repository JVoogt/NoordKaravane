---
// Inspection report proof block on the Caravan service page: what the visitor gets after the walk-around, in
// words, beside the same sample job card the Home page shows (SampleReport: one component, one data source).
import { servicePath } from '../data/routes';
import SampleReport from './SampleReport.astro';
---

<section id="inspection-report" class="sec">
  <div class="wrap inspection-wrap">
    <div>
      <h2>What the inspection report shows</h2>
      <div class="inspection-summary">
        <p>Each finding gets photos and a note. Safety work is listed apart from the nice-to-haves, so you can decide what to do now and what can wait. Nothing extra gets done without your go-ahead.</p>
        <p class="inspection-links">Worn bearings, brakes or woodrot become a <a class="link" href={servicePath('repairs')}>caravan repair</a> quote. Battery or solar trouble goes to <a class="link" href={servicePath('solar-electrical')}>electrical and solar</a>.</p>
      </div>
    </div>
    <SampleReport />
  </div>
</section>
