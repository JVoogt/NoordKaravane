---
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
import { buildGraph, jsonLd } from '../lib/schema';
import { WA_TEXT, waUrl } from '../lib/whatsapp';
---

<Base
  title="Page not found | Noord Karavane"
  description="That page does not exist. Head back to the Noord Karavane home page or WhatsApp the workshop."
  path="/404.html"
  jsonLd={jsonLd(buildGraph([]))}
  noindex
>
  <section class="notfound">
    <div class="container">
      <h1 class="hero-title">Page <span class="accent">not found.</span></h1>
      <p class="hero-lede">The page you were looking for is not here. Head back home, or message the workshop directly.</p>
      <div class="hero-actions">
        <CtaButton href="/" variant="primary">Back to home</CtaButton>
        <CtaButton href={waUrl(WA_TEXT.enquire)} variant="whatsapp" external arrow>Book on WhatsApp</CtaButton>
      </div>
    </div>
  </section>
</Base>
