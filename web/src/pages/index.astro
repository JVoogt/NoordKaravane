---
import { Picture } from 'astro:assets';
import liftKit from '../assets/lift-kit.jpg';
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import CtaButton from '../components/CtaButton.astro';
import Reviews from '../components/Reviews.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { BUSINESS } from '../data/business';
import { ADDONS, AXLE_OPTIONS, fmtR } from '../data/pricing';
import { servicePath } from '../data/routes';
import { SERVICE_LIST } from '../data/services';
import { buildGraph, jsonLd, orgNode } from '../lib/schema';
import { WA_TEXT, waUrl } from '../lib/whatsapp';

const a = BUSINESS.address;
const from = fmtR(Math.min(...AXLE_OPTIONS.map((o) => o.price)));
const axle = (id: string): string => fmtR(AXLE_OPTIONS.find((o) => o.id === id)!.price);
const liftKitPrice = fmtR(ADDONS.find((o) => o.id === 'lift-kit')!.price);
const graph = buildGraph([orgNode()]);
const description = `Caravan workshop at ${a.street}, ${a.locality}: services from ${from}, repairs, electrical and solar, 50 mm lift kits and insurance-accredited recoveries.`;

const steps = [
  { h: "Tell us what's going on", p: "Send a WhatsApp with the make and year, what it's doing, and a photo if you have one." },
  { h: 'We inspect and report', p: 'On the ramp we check the running gear, electrics and structure, and write it up with photos.' },
  { h: 'You approve the quote', p: 'Safety work is listed apart from the nice-to-haves. Nothing extra happens until you say yes.' },
];
---

<Base
  title="Noord Karavane | Caravan Service, Repairs & Recoveries in Pretoria North"
  description={description}
  path="/"
  jsonLd={jsonLd(graph)}
>
  <header class="hero hero--home">
    <div class="container hero-grid">
      <div class="hero-main">
        <h1 class="hero-title">
          <span class="hero-title-place">Caravan workshop in {a.locality}<span class="sr-only">. </span></span>
          Keep her <span class="accent">road-ready.</span>
        </h1>
        <p class="hero-lede">
          Caravan servicing, repairs, electrical and solar, 50 mm lift kits and recoveries, from {a.street}. Services and repairs start with an inspection: you see what we found, and what it'll cost, before we pick up a spanner.
        </p>
        <div class="hero-actions">
          <CtaButton href={waUrl(WA_TEXT.book)} variant="primary" external arrow>Book on WhatsApp</CtaButton>
          <CtaButton href={servicePath('caravan-service') + '#pricing'} variant="ghost">Service packages from {from}</CtaButton>
        </div>
        <TrustStrip />
      </div>

      <div class="hero-media">
        <Picture
          src={liftKit}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 640, 900]}
          sizes="(max-width: 1100px) 480px, 560px"
          quality={70}
          alt="Caravan with a lift kit in the Noord Karavane workshop"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-media-stamp" aria-hidden="true">Road<br />Ready</div>
      </div>
    </div>
  </header>

  <section id="services" class="block">
    <div class="container">
      <div class="sec-head">
        <h2 class="sec-title">What does your caravan need?</h2>
        <p class="sec-sub">Start with the problem. Each page covers what we check, what it costs and how to book.</p>
      </div>
      <div class="svc-grid">
        {SERVICE_LIST.map((s) => <ServiceCard slug={s.slug} />)}
      </div>
      <p class="svc-prices">
        A service costs {axle('unbraked-1')} for a single axle without brakes, up to {axle('braked-2')} for a double axle with brakes. A 50 mm lift kit is {liftKitPrice} fitted. Repairs and solar work are quoted before we start, and the solar quote is free.
      </p>
      <p class="svc-help">
        Not sure what it's called? <a href={waUrl(WA_TEXT.describe)} target="_blank" rel="noopener">Send a photo on WhatsApp</a> and tell us what it's doing.
      </p>
    </div>
  </section>

  <section id="why-us" class="block">
    <div class="container how-grid">
      <div class="how-main">
        <div class="sec-head">
          <h2 class="sec-title">How a job runs here</h2>
        </div>
        <ol class="how-steps">
          {steps.map((s, i) => (
            <li>
              <span class="how-n" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.h}</h3>
                <p>{s.p}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="text-link" href={servicePath('caravan-service') + '#process'}>See the full service process and an example report</a>
      </div>
      <aside id="reviews" class="how-proof" aria-label="Google reviews">
        <Reviews />
      </aside>
    </div>
  </section>

  <ContactBand
    id="location"
    heading="Find the workshop"
    text={`${a.street}, ${a.locality}. WhatsApp us before you tow in, so we can book you a slot.`}
    waText={WA_TEXT.findUs}
    placeLabel="Map and directions"
  >
    <p id="rentals" class="contact-aside">
      Don't own a caravan yet? <a href={BUSINESS.links.kampi} target="_blank" rel="noopener">Rent one through Kampi</a>, our partner rental marketplace.
    </p>
  </ContactBand>

  <script>
    import '../scripts/legacy-hash';
  </script>
</Base>
