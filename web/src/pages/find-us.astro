---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import wallSign from '../assets/workshop-wall-sign.jpg';
import workshop from '../assets/workshop.jpg';
import ContactBand from '../components/ContactBand.astro';
import CtaButton from '../components/CtaButton.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { BUSINESS } from '../data/business';
import { servicePath } from '../data/routes';
import { SERVICE_LIST } from '../data/services';
import { formatHoursProse, formatHoursRows } from '../lib/hours';
import type { FaqItem } from '../lib/faq';
import { listWithAnd } from '../lib/prose';
import { breadcrumbNode, buildGraph, faqNode, jsonLd, orgNode } from '../lib/schema';
import { WA_TEXT, waUrl } from '../lib/whatsapp';

const path = '/find-us/';
// Friday closing time comes from business.ts, never typed here.
const friday = BUSINESS.hours.fri;
const a = BUSINESS.address;
const tel = `tel:${BUSINESS.phone.e164}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Find us', path },
];

// Old FAQ Q07 keeps its question. {hours} is expanded from business.ts when the page is rendered, never frozen here.
const faq: FaqItem[] = [
  {
    q: 'Where is Noord Karavane located?',
    a: `${a.street}, ${a.locality}. Open {hours} We also offer on-site services at your location for a call-out fee.`,
  },
  {
    q: 'Do I need to book before I bring my caravan in?',
    a: "It helps. Send a WhatsApp first and we'll give you a time to bring it in.",
  },
  {
    q: 'Can I bring it in on a Friday?',
    a: friday ? `Yes. The workshop closes at ${friday.closes} on a Friday, so come in earlier in the day.` : 'No, the workshop is closed on Fridays.',
  },
];

// Right for one country, and a build error for none (lib/prose).
const countryList = listWithAnd(BUSINESS.crossBorder.map((c) => c.name));
const coords = `${BUSINESS.geo.lat.toFixed(5)}, ${BUSINESS.geo.lng.toFixed(5)}`;

const mapEmbed = `https://maps.google.com/maps?q=${BUSINESS.links.mapsQuery}&t=&z=16&ie=UTF8&iwloc=B&output=embed`;
const mapLink = `https://maps.google.com/maps?q=${BUSINESS.links.mapsQuery}`;

const graph = buildGraph([orgNode(), breadcrumbNode(crumbs), faqNode(faq)]);
---

<Base
  title="Find Us in Pretoria North | Noord Karavane"
  description={`${a.street}, ${a.locality}. Open ${formatHoursProse(BUSINESS.hours)} WhatsApp ${BUSINESS.phone.display}.`}
  path={path}
  waText={WA_TEXT.findUs}
  jsonLd={jsonLd(graph)}
>
  <PageHero
    h1={`Find the workshop in ${a.locality}`}
    crumbs={crumbs}
    photo={{ src: workshop, alt: `Inside the ${BUSINESS.name} workshop: a caravan between the lifts, with the workbench along the window wall`, position: '50% 60%' }}
  >
    <p class="lede hero-lede">{a.street}, {a.locality}, {a.postalCode}. A quick WhatsApp before you tow in means we're ready for you.</p>
    <div class="cta-row hero-actions">
      <CtaButton href={mapLink} variant="primary" external>Get directions</CtaButton>
      <CtaButton href={waUrl(WA_TEXT.findUs)} variant="ghost" icon="wa" external>Book a time on WhatsApp</CtaButton>
    </div>
  </PageHero>

  <section id="location" class="sec">
    <div class="wrap loc-grid">
      <dl class="find-facts loc-facts nums">
        <div>
          <dt>Address</dt>
          <dd>{a.street}<br /><small>{a.locality}, {a.city}, {a.postalCode}</small></dd>
        </div>
        <div>
          <dt>Workshop hours</dt>
          <dd class="hrs">
            {formatHoursRows(BUSINESS.hours).map((r) => <Fragment><span>{r.days}</span>{' '}<span>{r.time}</span>{' '}</Fragment>)}
          </dd>
        </div>
        <div>
          <dt>Call</dt>
          <dd><a class="find-tel" href={tel}>{BUSINESS.phone.display}</a><small>WhatsApp preferred (faster replies)</small></dd>
        </div>
      </dl>

      {/* The address, GPS and the Maps link sit in a bar on the map frame itself, so the box says something useful
          while Google's map loads, if it never loads, and with JavaScript off. The bar is outside the iframe, so
          it stays clickable and in the Tab order after the map appears. */}
      <div class="map-card">
        <div class="map-bar nums">
          <p class="map-bar-addr">
            <strong>{a.street}, {a.locality}</strong>
            <span>GPS {coords}</span>
          </p>
          <a class="btn btn-primary" href={mapLink} target="_blank" rel="noopener">Open in Google Maps</a>
        </div>
        <div class="loc-map">
          <p class="loc-map-wait" aria-hidden="true">The map loads here. If it doesn't, use Open in Google Maps above.</p>
          <iframe src={mapEmbed} loading="lazy" title="Map of the Noord Karavane workshop" width="600" height="420"></iframe>
        </div>
      </div>

      {/* What to look for from the street: the painted wall. */}
      <figure class="loc-photo">
        <Image src={wallSign} widths={[480, 800]} sizes="(max-width: 860px) 92vw, 600px" format="webp" quality={72} alt={`The painted Noord Karavane sign on the workshop wall, with ${BUSINESS.phone.display} and ${a.street}, ${a.locality}`} />
        <figcaption>Look for this painted wall at {a.street}. Our sign is on the left, beside the Kampi one.</figcaption>
      </figure>

      <div class="loc-text">
        <h2>Getting here</h2>
        <p>The workshop is at {a.street} in {a.locality}, {a.city}. For a satnav, the GPS position is {coords}.</p>
        <h2>Where our customers come from</h2>
        <p>We work on caravans and trailers from Pretoria North and the suburbs around it (Wonderboom, Sinoville, Montana, Annlin and Akasia), from across Pretoria and Centurion, and from Midrand and Johannesburg. Owners also come in from Brits, Hartbeespoort, Rustenburg and Limpopo.</p>
        <p>For a <a href={servicePath('recoveries')}>caravan or trailer recovery</a> we come to you, anywhere in South Africa and across the border to {countryList}.</p>
        <h2>What we do here</h2>
        <ul class="loc-services">
          {SERVICE_LIST.map((s) => <li><a href={servicePath(s.slug)}>{s.name}<Icon name="go" /></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="faq" class="sec">
    <div class="wrap sec-split">
      <div class="sec-head">
        <h2>Visiting the workshop</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <ContactBand waText={WA_TEXT.findUs} heading="Book a time to bring it in" place="none" />
</Base>

<script>
  // Tabbing into Google's map moves focus inside a cross-origin frame, where neither :focus nor :focus-within
  // matches on this page. Mark the iframe while it holds focus so its frame shows the same ring as everything else.
  const frame = document.querySelector<HTMLIFrameElement>('.loc-map iframe');
  if (frame) {
    const sync = () => frame.classList.toggle('has-focus', document.activeElement === frame);
    window.addEventListener('blur', () => setTimeout(sync, 0));
    window.addEventListener('focus', sync);
    document.addEventListener('focusin', sync);
  }
</script>
