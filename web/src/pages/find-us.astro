---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButton from '../components/CtaButton.astro';
import Faq from '../components/Faq.astro';
import Hours from '../components/Hours.astro';
import { BUSINESS } from '../data/business';
import { formatHoursProse } from '../lib/hours';
import type { FaqItem } from '../lib/faq';
import { breadcrumbNode, buildGraph, faqNode, jsonLd, orgNode } from '../lib/schema';
import { WA_TEXT, waUrl } from '../lib/whatsapp';

const path = '/find-us/';
const a = BUSINESS.address;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Find us', path },
];

// Old FAQ Q07. {hours} is expanded from business.ts when the page is rendered, never frozen here.
const faq: FaqItem[] = [
  {
    q: 'Where is Noord Karavane located?',
    a: `${a.street}, ${a.locality}. Open {hours} We also offer on-site services at your location for a call-out fee.`,
  },
];

// Old "Service Areas" paragraph, kept as one paragraph. The country list comes from business.ts.
const areas =
  'Pretoria North, Pretoria Central, Pretoria East, Pretoria West, Centurion, Midrand, Johannesburg, Wonderboom, Sinoville, Montana, Annlin, Akasia, Rosslyn, Ga-Rankuwa, Brits, Hartbeespoort, Rustenburg, Limpopo, and the greater Gauteng region.';
const countries = BUSINESS.crossBorder.map((c) => c.name);
const countryList = `${countries.slice(0, -1).join(', ')} and ${countries[countries.length - 1]}`;

const mapEmbed = `https://maps.google.com/maps?q=${BUSINESS.links.mapsQuery}&t=&z=16&ie=UTF8&iwloc=B&output=embed`;
const mapLink = `https://maps.google.com/maps?q=${BUSINESS.links.mapsQuery}`;

const graph = buildGraph([orgNode(), breadcrumbNode(crumbs), faqNode(faq)]);
---

<Base
  title="Find Us in Pretoria North | Noord Karavane"
  description={`Noord Karavane is at ${a.street}, ${a.locality}. Open ${formatHoursProse(BUSINESS.hours)} WhatsApp ${BUSINESS.phone.display}.`}
  path={path}
  waText={WA_TEXT.findUs}
  jsonLd={jsonLd(graph)}
>
  <header class="hero">
    <div class="container hero-grid hero-grid--single">
      <div class="hero-main">
        <Breadcrumbs items={crumbs} />
        <p class="hero-eyebrow">Find us</p>
        <h1 class="hero-title hero-title--service">Drop in. <span class="accent">Kettle's always on.</span></h1>
        <p class="hero-lede">{a.street}, {a.locality}. Easy to find, easier to park a caravan at.</p>
        <div class="hero-actions hero-actions--spaced">
          <CtaButton href={waUrl(WA_TEXT.findUs)} variant="primary" external arrow>Book a slot</CtaButton>
          <CtaButton href={`tel:${BUSINESS.phone.e164}`} variant="ghost">Call {BUSINESS.phone.display}</CtaButton>
        </div>
      </div>
    </div>
  </header>

  <section id="location" class="block">
    <div class="container">
      <div class="loc-grid loc-grid--split">
        <div class="loc-card">
          <div class="loc-item">
            <div class="loc-k">Address</div>
            <div class="loc-v">{a.street}<br /><small>{a.locality}, {a.city}, {a.postalCode}</small></div>
          </div>
          <div class="loc-item">
            <div class="loc-k">Call</div>
            <div class="loc-v"><a href={`tel:${BUSINESS.phone.e164}`}>{BUSINESS.phone.display}</a><small>WhatsApp preferred (faster replies)</small></div>
          </div>
          <div class="loc-item">
            <div class="loc-k">Hours</div>
            <Hours />
          </div>
          <div class="loc-item">
            <div class="loc-k">Recoveries</div>
            <div class="loc-v">Nationwide + cross-border<br /><small>{BUSINESS.crossBorder.map((c) => c.code).join(' · ')}</small></div>
          </div>
        </div>
        <div class="loc-map">
          {/* tabindex -1: a cross-origin iframe shows no focus ring from the page, so it stays out of the Tab order; the text link below is the keyboard route. */}
          <span class="loc-map-pill">Workshop</span>
          <iframe src={mapEmbed} loading="lazy" title="Workshop map" width="600" height="480" tabindex="-1"></iframe>
        </div>
      </div>
      <p class="frame-fallback">Can't see the map? <a href={mapLink} target="_blank" rel="noopener">Open in Google Maps</a></p>

      <div class="service-areas">
        <h2>Service Areas</h2>
        <p>Noord Karavane proudly serves caravan and trailer owners across {areas} We also provide cross-border caravan and trailer recoveries to {countryList}.</p>
      </div>
    </div>
  </section>

  <section id="faq" class="block">
    <div class="container">
      <div class="sec-head">
        <div class="sec-num">&#9830; FAQ</div>
        <h2 class="sec-title">The <em>questions</em> that come up most.</h2>
        <p class="sec-sub">Short answers. Message us for the full story.</p>
      </div>
      <Faq items={faq} />
    </div>
  </section>
</Base>
