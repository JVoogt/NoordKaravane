---
import { getCollection, render } from 'astro:content';
import Service from '../../layouts/Service.astro';
import Estimator from '../../components/Estimator.astro';
import InspectionReport from '../../components/InspectionReport.astro';
import LiftKitSpecs from '../../components/LiftKitSpecs.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import { BUSINESS } from '../../data/business';
import { AXLE_OPTIONS, fmtR, type AxleId } from '../../data/pricing';
import { waUrl } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Static package rows for the caravan page (old page wording). Amounts come from pricing.ts.
// They only list the packages; the estimator next to them does the choosing.
const packages: Array<{ id: AxleId; mark: string; name: string; meta: string }> = [
  { id: 'unbraked-1', mark: 'A', name: 'Single axle, unbraked', meta: 'Safety · Brakes · Bearings' },
  { id: 'braked-1', mark: 'B', name: 'Single axle, braked', meta: 'Most popular: full service' },
  { id: 'braked-2', mark: 'C', name: 'Double axle, braked', meta: 'For bigger rigs & tourers' },
];
const amountOf = (id: AxleId): string => fmtR(AXLE_OPTIONS.find((o) => o.id === id)!.price);
---

<Service entry={entry} bodyBelow={entry.id === 'repairs'} emergency={entry.id === 'recoveries'}>
  <Content />
  {entry.id === 'recoveries' && (
    <p slot="tag" class="hero-badge-row"><span class="hero-badge">{BUSINESS.recoveriesNote}</span></p>
  )}
  {entry.id === 'recoveries' && (
    <ul slot="hero-extra" class="chip-list" aria-label="Cross-border recoveries">
      {BUSINESS.crossBorder.map((c) => <li>{c.name}</li>)}
    </ul>
  )}

  {entry.id === 'caravan-service' && (
    <Fragment slot="extras">
      <section id="pricing" class="block">
        <div class="container">
          <div class="sec-head">
            <div class="sec-num" aria-hidden="true">&sect; 01 / 03</div>
            <h2 class="sec-title">Straightforward <span class="accent">packages.</span></h2>
            <p class="sec-sub">Pick a package or build a custom estimate. Parts quoted separately; nothing sneaks on.</p>
          </div>
          <div class="pricing-wrap">
            <div class="price-cards">
              {packages.map((p) => (
                <div class="price">
                  <div class="price-mark" aria-hidden="true">{p.mark}</div>
                  <div>
                    <h3>{p.name}</h3>
                    <div class="meta">{p.meta}</div>
                  </div>
                  <div class="amt">{amountOf(p.id)}<sub>from</sub></div>
                </div>
              ))}
            </div>
            <Estimator />
          </div>
        </div>
      </section>
      <InspectionReport />
      <ProcessSteps />
    </Fragment>
  )}

  {entry.id === 'lift-kits' && <LiftKitSpecs slot="extras" href={waUrl(entry.data.whatsappText)} label={entry.data.ctaLabel} />}
</Service>
