---
import { getCollection, render } from 'astro:content';
import Service from '../../layouts/Service.astro';
import CtaButton from '../../components/CtaButton.astro';
import Estimator from '../../components/Estimator.astro';
import InspectionReport from '../../components/InspectionReport.astro';
import LiftKitSpecs from '../../components/LiftKitSpecs.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import { BUSINESS } from '../../data/business';
import { AXLE_OPTIONS, fmtR, type AxleId } from '../../data/pricing';
import { waUrl } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const id = entry.id;
// The caravan page shows its markdown (the service checklist) inside the pricing section, beside the packages,
// so the section order stays hero, pricing, inspection report, process, FAQ. Other pages put it under the hero.
const bodyUnderHero = id !== 'caravan-service' && (entry.body ?? '').trim().length > 0;

// Static package rows for the caravan page. Amounts come from pricing.ts; the estimator next to them does the choosing.
const packages: Array<{ id: AxleId; name: string }> = [
  { id: 'unbraked-1', name: 'Single axle, no brakes' },
  { id: 'braked-1', name: 'Single axle with brakes' },
  { id: 'braked-2', name: 'Double axle with brakes' },
];
const amountOf = (axle: AxleId): string => fmtR(AXLE_OPTIONS.find((o) => o.id === axle)!.price);
---

<Service entry={entry} bodyColumns={id === 'repairs'} emergency={id === 'recoveries'} body={bodyUnderHero}>
  {bodyUnderHero && <Content />}
  {id === 'recoveries' && (
    <p slot="tag" class="hero-badge-row"><span class="hero-badge">{BUSINESS.recoveriesNote}</span></p>
  )}
  {id === 'recoveries' && (
    <ul slot="hero-extra" class="chip-list" aria-label="Countries we recover from, besides South Africa">
      {BUSINESS.crossBorder.map((c) => <li>{c.name}</li>)}
    </ul>
  )}

  {id === 'caravan-service' && (
    <Fragment slot="extras">
      {/* A long page with four jobs: jump links to each, plain anchors, not sticky (the header already is). */}
      <nav class="page-nav" aria-label="On this page">
        <div class="container">
          <ul>
            <li><a href="#pricing">Prices</a></li>
            <li><a href="#included">Included</a></li>
            <li><a href="#inspection-report">Report</a></li>
            <li><a href="#contact">Book</a></li>
          </ul>
        </div>
      </nav>
      <section id="pricing" class="block">
        <div class="container">
          <div class="sec-head">
            <h2 class="sec-title">Caravan service packages and prices</h2>
            <p class="sec-sub">Every package covers the same checklist. The price follows the axles and brakes, because that is where the hours go.</p>
          </div>
          <div class="pricing-wrap">
            <div class="pricing-main">
              <div class="price-cards">
                {packages.map((p) => (
                  <div class="price">
                    <h3>{p.name}</h3>
                    <div class="amt">{amountOf(p.id)}<sub>from</sub></div>
                  </div>
                ))}
              </div>
              <div class="svc-includes" id="included"><Content /></div>
            </div>
            <Estimator />
          </div>
          <div class="book-row">
            <p>Know which package you need? Book your slot now. The report and the process are further down.</p>
            <CtaButton href={waUrl(entry.data.whatsappText)} variant="primary" external arrow>{entry.data.ctaLabel}</CtaButton>
          </div>
        </div>
      </section>
      <InspectionReport />
      <ProcessSteps />
    </Fragment>
  )}

  {id === 'lift-kits' && <LiftKitSpecs slot="extras" href={waUrl(entry.data.whatsappText)} label={entry.data.ctaLabel} />}
</Service>
