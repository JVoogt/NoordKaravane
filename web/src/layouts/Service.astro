---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactBand from '../components/ContactBand.astro';
import CtaButton from '../components/CtaButton.astro';
import Faq from '../components/Faq.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { BUSINESS } from '../data/business';
import { servicePath, type ServiceSlug } from '../data/routes';
import { serviceMeta } from '../data/services';
import { assertRelatedOk, priceAmount } from '../lib/content-schema';
import { buildGraph, breadcrumbNode, faqNode, jsonLd, orgStubNode, serviceNode } from '../lib/schema';
import { waUrl } from '../lib/whatsapp';

interface Props {
  entry: CollectionEntry<'services'>;
  /** Markdown body as three side-by-side columns under the hero (Repairs: one column per kind of repair). */
  bodyColumns?: boolean;
  /** Emergency page: the Call button is filled and first, with the same weight as WhatsApp. */
  emergency?: boolean;
  /** Render the default slot (the markdown body) in its own section under the hero. */
  body?: boolean;
}
const { entry, bodyColumns = false, emergency = false, body = false } = Astro.props;
const d = entry.data;
const slug = entry.id as ServiceSlug;
assertRelatedOk(slug, d.related);
const path = servicePath(slug);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: serviceMeta(slug).name, path },
];

const graph = buildGraph([
  orgStubNode(),
  breadcrumbNode(crumbs),
  serviceNode({
    name: d.schemaName,
    description: d.description,
    path,
    price: d.priceFrom ? { amount: priceAmount(d.priceFrom.id), from: d.priceFrom.from } : undefined,
    areaServed: emergency ? 'recoveries' : undefined,
  }),
  faqNode(d.faq),
]);
const g = BUSINESS.google;
---

<Base title={d.title} description={d.description} path={path} waText={d.whatsappText} jsonLd={jsonLd(graph)}>
  <header class="hero hero--service">
    <div class="container hero-grid hero-grid--panel">
      <div class="hero-main">
        <Breadcrumbs items={crumbs} />
        <slot name="tag" />
        <h1 class="hero-title hero-title--service">{d.h1}</h1>
        <p class="hero-lede">{d.lede}</p>
        <div class="hero-actions">
          {emergency ? (
            <Fragment>
              <CtaButton href={`tel:${BUSINESS.phone.e164}`} variant="primary">Call {BUSINESS.phone.display}</CtaButton>
              <CtaButton href={waUrl(d.whatsappText)} variant="primary" external arrow>{d.ctaLabel}</CtaButton>
            </Fragment>
          ) : (
            <Fragment>
              <CtaButton href={waUrl(d.whatsappText)} variant="primary" external arrow>{d.ctaLabel}</CtaButton>
              <CtaButton href={`tel:${BUSINESS.phone.e164}`} variant="ghost">Call {BUSINESS.phone.display}</CtaButton>
            </Fragment>
          )}
        </div>
        <p class="hero-proof">
          <a href={BUSINESS.links.googleProfile} target="_blank" rel="noopener">{g.rating.toFixed(1)} on Google from {g.reviewCount} reviews</a>
        </p>
      </div>
      <div class="hero-panel">
        {d.facts && d.facts.length > 0 && (
          <dl class="facts">
            {d.facts.map((f) => (
              <div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
          </dl>
        )}
        <slot name="hero-extra" />
      </div>
    </div>
  </header>

  {body && (
    <section class="block block--tight" id="details">
      <div class="container">
        <div class:list={['svc-body', bodyColumns ? 'svc-cols' : 'svc-split']}><slot /></div>
      </div>
    </section>
  )}

  <slot name="extras" />

  <section id="faq" class="block">
    <div class="container faq-layout">
      <div class="sec-head">
        <h2 class="sec-title">{d.faqTitle}</h2>
        <p class="sec-sub">Not covered here? <a href={waUrl(d.whatsappText)} target="_blank" rel="noopener">Ask us on WhatsApp</a>.</p>
      </div>
      <Faq items={d.faq} />
    </div>
  </section>

  {d.related.length > 0 && (
    <section class="block block--tight" id="related">
      <div class="container">
        <div class="sec-head">
          <h2 class="sec-title">Related services</h2>
        </div>
        <div class="related-grid">
          {d.related.map((rel) => <ServiceCard slug={rel} compact />)}
        </div>
      </div>
    </section>
  )}

  <ContactBand waText={d.whatsappText} heading={d.closing?.heading} text={d.closing?.text} recoveries={emergency} callFirst={emergency} />
</Base>
