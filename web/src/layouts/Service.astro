---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactBand from '../components/ContactBand.astro';
import CtaButton from '../components/CtaButton.astro';
import Faq from '../components/Faq.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { BUSINESS } from '../data/business';
import { servicePath, type ServiceSlug } from '../data/routes';
import { serviceMeta } from '../data/services';
import { assertRelatedOk, priceAmount } from '../lib/content-schema';
import { buildGraph, breadcrumbNode, faqNode, jsonLd, orgStubNode, serviceNode } from '../lib/schema';
import { waUrl } from '../lib/whatsapp';

interface Props {
  entry: CollectionEntry<'services'>;
  /** Markdown body as three side-by-side columns under the hero (Repairs: one column per kind of repair). */
  bodyColumns?: boolean;
  /** Emergency page: Call is the filled primary action and comes first, WhatsApp is the ghost second choice. */
  emergency?: boolean;
  /** Render the default slot (the markdown body) in its own section under the hero. */
  body?: boolean;
}
const { entry, bodyColumns = false, emergency = false, body = false } = Astro.props;
const d = entry.data;
const slug = entry.id as ServiceSlug;
assertRelatedOk(slug, d.related);
const path = servicePath(slug);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: serviceMeta(slug).name, path },
];

const graph = buildGraph([
  orgStubNode(),
  breadcrumbNode(crumbs),
  serviceNode({
    name: d.schemaName,
    description: d.description,
    path,
    price: d.priceFrom ? { amount: priceAmount(d.priceFrom.id), from: d.priceFrom.from } : undefined,
    areaServed: emergency ? 'recoveries' : undefined,
  }),
  faqNode(d.faq),
]);
const g = BUSINESS.google;
const lone = d.related.length === 1 ? serviceMeta(d.related[0]) : null;
---

<Base title={d.title} description={d.description} path={path} waText={d.whatsappText} jsonLd={jsonLd(graph)}>
  <header class="hero hero--service">
    <div class="container hero-grid hero-grid--panel">
      <div class="hero-main">
        <Breadcrumbs items={crumbs} />
        <slot name="tag" />
        <h1 class="hero-title hero-title--service">{d.h1}</h1>
        {/* Stranded visitor: the Call button straight under the H1, WhatsApp second, then the safety line. */}
        {emergency ? (
          <Fragment>
            <div class="hero-actions hero-actions--emergency">
              <CtaButton href={`tel:${BUSINESS.phone.e164}`} variant="primary">Call {BUSINESS.phone.display}</CtaButton>
              <CtaButton href={waUrl(d.whatsappText)} variant="ghost" external>{d.ctaLabel}</CtaButton>
            </div>
            {d.safety && <p class="hero-safety">{d.safety}</p>}
            <p class="hero-lede">{d.lede}</p>
          </Fragment>
        ) : (
          <Fragment>
            <p class="hero-lede">{d.lede}</p>
            <div class="hero-actions">
              <CtaButton href={waUrl(d.whatsappText)} variant="primary" external>{d.ctaLabel}</CtaButton>
              <CtaButton href={`tel:${BUSINESS.phone.e164}`} variant="ghost">Call {BUSINESS.phone.display}</CtaButton>
            </div>
          </Fragment>
        )}
        <p class="hero-proof">
          <a href={BUSINESS.links.googleProfile} target="_blank" rel="noopener">{g.rating.toFixed(1)} on Google from {g.reviewCount} reviews</a>
        </p>
      </div>
      <div class="hero-panel">
        {d.checklist && (
          <div class="checklist" id="what-to-send">
            <h2 class="checklist-title">{d.checklist.heading}</h2>
            <ul>{d.checklist.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        )}
        <div class="hero-facts" id={emergency ? 'service-area' : undefined}>
          {d.facts && d.facts.length > 0 && (
            <dl class="facts">
              {d.facts.map((f) => (
                <div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>
              ))}
            </dl>
          )}
          <slot name="hero-extra" />
        </div>
      </div>
    </div>
  </header>

  {body && (
    <section class="block block--tight" id="details">
      <div class="container">
        <div class:list={['svc-body', bodyColumns ? 'svc-cols' : 'svc-split']}><slot /></div>
      </div>
    </section>
  )}

  <slot name="extras" />

  <section id="faq" class="block">
    <div class="container faq-layout">
      <div class="sec-head">
        <h2 class="sec-title">{d.faqTitle}</h2>
        <p class="sec-sub">Not covered here? <a href={waUrl(d.whatsappText)} target="_blank" rel="noopener">Ask us on WhatsApp</a>.</p>
      </div>
      <Faq items={d.faq} />
    </div>
  </section>

  {/* Two or more related services get a card band; a lone one is a sentence in the closing band (below), not a
      card stranded in an empty row. */}
  {d.related.length > 1 && (
    <section class="block block--tight" id="related">
      <div class="container related-layout">
        <div class="sec-head">
          <h2 class="sec-title">Related services</h2>
        </div>
        <div class:list={['related-grid', `related-grid--${Math.min(d.related.length, 3)}`]}>
          {d.related.map((rel) => <ServiceCard slug={rel} compact />)}
        </div>
      </div>
    </section>
  )}

  <ContactBand waText={d.whatsappText} heading={d.closing?.heading} text={d.closing?.text} recoveries={emergency} callFirst={emergency}>
    {lone && (
      <p class="contact-aside contact-related">
        {lone.need}? See <a href={servicePath(lone.slug)}>{lone.name.charAt(0).toLowerCase() + lone.name.slice(1)}</a>.
      </p>
    )}
  </ContactBand>
</Base>

<style>
  .checklist-title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(28px, 2.6vw, 34px);
    line-height: 1;
    margin-bottom: 14px;
    min-width: 0;
    overflow-wrap: break-word;
  }
</style>
