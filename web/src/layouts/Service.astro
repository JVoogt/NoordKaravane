---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import ContactBand from '../components/ContactBand.astro';
import CtaButton from '../components/CtaButton.astro';
import Faq from '../components/Faq.astro';
import PageHero from '../components/PageHero.astro';
import Plates from '../components/Plates.astro';
import ServiceBoard from '../components/ServiceBoard.astro';
import { BUSINESS } from '../data/business';
import { servicePath, type ServiceSlug } from '../data/routes';
import { serviceMeta } from '../data/services';
import { assertEmergencyFields, assertRelatedOk, priceAmount } from '../lib/content-schema';
import { buildGraph, breadcrumbNode, faqNode, jsonLd, orgStubNode, serviceNode } from '../lib/schema';
import { waUrl } from '../lib/whatsapp';

interface Props {
  entry: CollectionEntry<'services'>;
  /** The hero photo. A page without one (Recoveries) fills the hero's second column with what to send and the
      country plates instead. */
  photo?: { src: ImageMetadata; alt: string; position?: string; caption?: string };
  /** Markdown body as three side-by-side columns under the hero (Repairs: one column per kind of repair). */
  bodyColumns?: boolean;
  /** Emergency page: Call is the filled primary action and comes first, WhatsApp is the outlined second choice. */
  emergency?: boolean;
  /** Render the default slot (the markdown body) in its own section under the hero. */
  body?: boolean;
}
const { entry, photo, bodyColumns = false, emergency = false, body = false } = Astro.props;
const d = entry.data;
const slug = entry.id as ServiceSlug;
assertRelatedOk(slug, d.related);
// safety and checklist are drawn in the emergency hero only: set anywhere else they fail the build, never vanish.
assertEmergencyFields(slug, d, emergency);
const path = servicePath(slug);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: serviceMeta(slug).name, path },
];

const graph = buildGraph([
  orgStubNode(),
  breadcrumbNode(crumbs),
  serviceNode({
    name: d.schemaName,
    description: d.description,
    path,
    price: d.priceFrom ? { amount: priceAmount(d.priceFrom.id), from: d.priceFrom.from } : undefined,
    areaServed: emergency ? 'recoveries' : undefined,
  }),
  faqNode(d.faq),
]);
const g = BUSINESS.google;
const tel = `tel:${BUSINESS.phone.e164}`;
const lone = d.related.length === 1 ? serviceMeta(d.related[0]) : null;
const hasFacts = !!d.facts && d.facts.length > 0;
---

<Base title={d.title} description={d.description} path={path} waText={d.whatsappText} jsonLd={jsonLd(graph)}>
  <PageHero h1={d.h1} crumbs={crumbs} photo={photo} side={emergency}>
    {/* Recoveries: the 24/7 claim sits under the headline (slot "tag"). */}
    <slot name="tag" />
    {/* Stranded visitor: the Call button straight under the H1, WhatsApp second, then the safety line. */}
    {emergency ? (
      <Fragment>
        <div class="cta-row hero-actions">
          <CtaButton href={tel} variant="primary" icon="tel">Call {BUSINESS.phone.display}</CtaButton>
          <CtaButton href={waUrl(d.whatsappText)} variant="ghost" icon="wa" external>{d.ctaLabel}</CtaButton>
        </div>
        {d.safety && <p class="hero-safety">{d.safety}</p>}
        <p class="lede hero-lede">{d.lede}</p>
      </Fragment>
    ) : (
      <Fragment>
        <p class="lede hero-lede">{d.lede}</p>
        <div class="cta-row hero-actions">
          <CtaButton href={waUrl(d.whatsappText)} variant="primary" icon="wa" external>{d.ctaLabel}</CtaButton>
          <CtaButton href={tel} variant="ghost" icon="tel">Call {BUSINESS.phone.display}</CtaButton>
        </div>
        {hasFacts && (
          <dl class="hero-facts nums">
            {d.facts!.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
          </dl>
        )}
      </Fragment>
    )}
    <p class="hero-proof nums">
      <a href={BUSINESS.links.googleProfile} target="_blank" rel="noopener">{g.rating.toFixed(1)} on Google from {g.reviewCount} reviews</a>
    </p>

    {/* Emergency page, second column: what to have ready, then where we recover (the plates and the facts). */}
    <Fragment slot="side">
      {d.checklist && (
        <div class="checklist" id="what-to-send">
          <h2 class="checklist-title">{d.checklist.heading}</h2>
          <ul>{d.checklist.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      )}
      <div class="hero-area" id="service-area">
        <Plates label="Countries we recover from, besides South Africa" />
        {hasFacts && (
          <dl class="hero-facts nums">
            {d.facts!.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
          </dl>
        )}
      </div>
    </Fragment>
  </PageHero>

  {body && (
    <section class="sec" id="details">
      <div class="wrap">
        <div class:list={['svc-body', bodyColumns ? 'svc-cols' : 'svc-split']}><slot /></div>
      </div>
    </section>
  )}

  <slot name="extras" />

  <section id="faq" class="sec">
    <div class="wrap sec-split">
      <div class="sec-head">
        <h2>{d.faqTitle}</h2>
        <p>Not covered here? <a class="link" href={waUrl(d.whatsappText)} target="_blank" rel="noopener">Ask us on WhatsApp</a>.</p>
      </div>
      <Faq items={d.faq} />
    </div>
  </section>

  {/* Two or more related services are rows of the price board; a lone one is a sentence in the closing band
      (below), not a board of one row. */}
  {d.related.length > 1 && (
    <section class="sec" id="related">
      <div class="wrap sec-split">
        <div class="sec-head">
          <h2>Related services</h2>
        </div>
        <ServiceBoard slugs={d.related} />
      </div>
    </section>
  )}

  <ContactBand waText={d.whatsappText} heading={d.closing?.heading} text={d.closing?.text} recoveries={emergency} callFirst={emergency}>
    {lone && (
      <p class="contact-aside contact-related">
        {lone.need}? See <a href={servicePath(lone.slug)}>{lone.name.charAt(0).toLowerCase() + lone.name.slice(1)}</a>.
      </p>
    )}
  </ContactBand>
</Base>
