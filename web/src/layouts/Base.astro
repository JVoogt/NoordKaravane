---
import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import Ticker from '../components/Ticker.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { BUSINESS } from '../data/business';
import { WA_TEXT, waUrl } from '../lib/whatsapp';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  waText?: string;
  /** Output of jsonLd(buildGraph(...)). */
  jsonLd: string;
  noindex?: boolean;
}
const { title, description, path, ogImage = '/assets/images/og-image-1200.jpg', waText = WA_TEXT.book, jsonLd, noindex = false } = Astro.props;
const canonical = BUSINESS.url + path;
const ogImageUrl = BUSINESS.url + ogImage;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />
    <meta name="author" content={BUSINESS.name} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Noord Karavane - Caravan Specialists in Pretoria North" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:site_name" content={BUSINESS.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Ticker />
    <Nav path={path} waText={waText} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <a href={waUrl(WA_TEXT.enquire)} class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5s.2-.3.3-.5c.1-.2 0-.4 0-.5s-.7-1.6-.9-2.2c-.2-.6-.5-.5-.7-.5s-.4 0-.6 0-.5.1-.8.4c-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg>
    </a>
  </body>
</html>
