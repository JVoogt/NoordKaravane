BREVO_API_KEY=                  # TODO stub
BREVO_LIST_ID=                  # TODO stub
CONTACT_TO=                     # TODO stub (defaults to email_general)
CONTACT_FROM=                   # authenticated Brevo sender (default orders@noordkaravane.co.za)
