{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": { "~/*": ["src/*"], "@brand": ["src/brands/nk/index.ts"], "@brand-copy": ["src/brands/nk/copy.ts"] }
  }
}
