---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { abs, trunc, organizationLd, websiteLd } from '~/lib/seo';
import { env, medusaUrl, publishableKey } from '~/lib/env';
import { business } from '~/lib/business';
import { u } from '~/lib/url';
// After global.css: the Kampi brand module brings its tokens and component layer, which must win over global.css.
import { fontPreloads } from '@brand';

interface Props {
  title: string;
  description?: string;
  path?: string;           // canonical path INCLUDING /shop (use u()); defaults to the request path
  image?: string;
  ogType?: 'website' | 'product' | 'article';
  jsonld?: object[];
  noindex?: boolean;
  mainClass?: string;
  floatingChat?: boolean;  // floating WhatsApp chip; off on buy/checkout pages where it would cover the CTA
}
const { title, description = business.tagline, path, image, ogType = 'website', jsonld = [], noindex = false, mainClass = '', floatingChat = true } = Astro.props;
const canonical = abs((path ?? Astro.url.pathname).replace(/(.)\/$/, '$1') === '/' ? '/' : (path ?? Astro.url.pathname));
// drop the brand suffix when it would push the title past ~60 chars (Google truncates)
const fullTitle = title.includes('Noord Karavane') || title.length > 44 ? title : `${title} | Noord Karavane`;
const desc = trunc(description);
const og = abs(image || u('/og-default.png'));
const clientEnv = {
  medusaUrl: medusaUrl(),
  publishableKey: publishableKey(),
  ga4: env('PUBLIC_GA4_ID'),
  pixel: env('PUBLIC_META_PIXEL_ID'),
  turnstile: env('PUBLIC_TURNSTILE_SITE_KEY'),
  freeShipping: business.shipping.free_shipping_threshold_zar,
};
const ld = [organizationLd(), websiteLd(), ...jsonld];
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0e0f11" />
    <link rel="icon" href={u('/icon-192.png')} type="image/png" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    {fontPreloads.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:site_name" content="Noord Karavane" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={og} />
    <slot name="head" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')} />)}

    <!-- Consent Mode v2: everything denied until the visitor chooses. Must run before any tag. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted', wait_for_update: 500 });
      window.gtag('set', 'ads_data_redaction', true);
      window.nkConsent = { analytics: false, marketing: false };
    </script>
    <script type="application/json" id="nk-env" set:html={JSON.stringify(clientEnv)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class={mainClass} tabindex="-1">
      <slot />
    </main>
    <Footer floatingChat={floatingChat} />
    <script>
      import '~/scripts/consent';
      import '~/scripts/site';
    </script>
  </body>
</html>
