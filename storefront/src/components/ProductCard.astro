---
import type { Product } from '~/lib/products';
import { zar } from '~/lib/format';
import { u } from '~/lib/url';
interface Props { product: Product; priority?: boolean }
const { product: p, priority = false } = Astro.props;
const [a, b] = p.images;
---
<a href={u(`/${p.handle}/`)} class="frame group" data-gtm-item={p.handle}>
  <div class="frame__photo">
    {a ? <img src={a.src} alt={a.alt} width="800" height="800" loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
       : <div class="grid h-full place-items-center text-muted"><span class="font-display text-3xl">Photo soon</span></div>}
    {b && <img src={b.src} alt="" width="800" height="800" loading="lazy" decoding="async" />}
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-3">
    <h3 class="frame__title">{p.title}</h3>
    <p class="typed shrink-0 text-[1.02rem] font-bold">{p.price != null ? `${p.priceMax && p.priceMax !== p.price ? 'from ' : ''}${zar(p.price)}` : ''}</p>
  </div>
</a>
