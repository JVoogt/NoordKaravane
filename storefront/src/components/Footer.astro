---
import Newsletter from './Newsletter.astro';
import { LEGAL_LINKS, HELP_LINKS } from '~/lib/nav';
import { business, isPlaceholder, whatsappNumber } from '~/lib/business';
import { u, LANDING } from '~/lib/url';
const b = business;
const { floatingChat = true } = Astro.props as { floatingChat?: boolean };
const wa = floatingChat ? whatsappNumber() : null;
const year = new Date().getFullYear();
const social = [
  { href: b.instagram, label: 'Instagram', d: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm4.5 4.8a4.2 4.2 0 1 0 0 8.4 4.2 4.2 0 0 0 0-8.4Zm5.2-1.6a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z' },
  { href: b.facebook, label: 'Facebook', d: 'M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.3C16.7 2.3 15.700 2.200 14.600 2.200 12.100 2.200 10.500 3.700 10.500 6.400v2.100H8v3.400h2.500V21H14v-9.100h2.600l.4-3.400H14Z' },
].filter((s) => s.href && !isPlaceholder(s.href));
const link = 'flex min-h-11 items-center no-underline hover:text-wine-lit';
---
<footer class="band-ink mt-24" id="footer">
  <div class="rail" aria-hidden="true"></div>
  <div class="wrap grid gap-14 pb-10 pt-16 lg:grid-cols-[1.1fr_1.6fr]">
    <div>
      <img src={u('/logo-white.png')} alt="Noord Karavane" width="64" height="64" class="size-16 object-contain" />
      <p class="display mt-6 text-[clamp(2.4rem,5vw,3.6rem)]">Family never gets<br />left behind.</p>
      <p class="mt-4 max-w-[38ch] text-muted">Caravan and camping gear, picked and fitted by a specialist caravan workshop in Pretoria North. Authorised Kampi agent.</p>
      <div class="mt-8 max-w-md"><Newsletter /></div>
    </div>

    <div class="grid gap-10 sm:grid-cols-3">
      <nav aria-label="Shop">
        <h2 class="label text-muted">Shop</h2>
        <ul class="mt-3">
          <li><a class={link} href={u('/')}>All products</a></li>
          <li><a class={link} href={u('/about')}>About us</a></li>
          <li><a class={link} href={LANDING}>Workshop &amp; servicing</a></li>
        </ul>
      </nav>
      <nav aria-label="Help">
        <h2 class="label text-muted">Help</h2>
        <ul class="mt-3">
          {HELP_LINKS.map((l) => <li><a class={link} href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2 class="label text-muted">The small print</h2>
        <ul class="mt-3">
          {LEGAL_LINKS.map((l) => <li><a class={link} href={l.href}>{l.label}</a></li>)}
          <li><button type="button" data-cookie-settings class="flex min-h-11 cursor-pointer items-center text-left hover:text-wine-lit">Cookie settings</button></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="wrap border-t border-ink-3 py-8">
    <div class="grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <address class="text-[0.85rem] leading-relaxed text-muted not-italic">
        <strong class="text-ink">{b.legal_name}</strong>. Reg. no. {b.registration_number}. VAT no. {b.vat_number}.<br />
        {b.physical_address}. Tel {b.phone}.<br />
        <a href={`mailto:${b.email_general}`} class="text-ink">{b.email_general}</a> &middot; Information Officer: {b.information_officer}.<br />
        Prices in ZAR, VAT inclusive.
      </address>
      <div class="flex flex-wrap items-start gap-2 lg:justify-end">
        {social.map((s) => (
          <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} class="grid size-11 place-items-center border border-ink-3 hover:border-ink hover:text-wine-lit">
            <svg width="22" height="22" viewBox="0 0 24 24" fill={s.label === 'Instagram' ? 'none' : 'currentColor'} stroke={s.label === 'Instagram' ? 'currentColor' : 'none'} stroke-width="1.6" aria-hidden="true"><path d={s.d} /></svg>
          </a>
        ))}
        <p class="w-full text-[0.8rem] text-muted lg:text-right">Pay: EFT &middot; Deliver: Pudo, The Courier Guy &middot; or collect</p>
      </div>
    </div>
    <p class="mt-8 text-[0.78rem] text-muted">&copy; {year} {b.brand} &middot; Pretoria North, South Africa</p>
  </div>
</footer>

{wa && (
  <a href={`https://wa.me/${wa}?text=${encodeURIComponent('Hi Noord Karavane! I have a question about ')}`} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp"
     class="no-print fixed bottom-4 right-4 z-[60] flex h-12 items-center gap-2 rounded-full bg-[#25D366] px-4 text-[#0e0f11] no-underline shadow-lg outline-offset-4 transition-transform hover:-translate-y-0.5 motion-reduce:transform-none sm:bottom-6 sm:right-6">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88Zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z"/></svg>
    <span class="hidden text-[0.85rem] font-semibold sm:inline">Chat</span>
  </a>
)}
