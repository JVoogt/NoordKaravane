---
import Base from '~/layouts/Base.astro';
import ProductBuy from '~/islands/ProductBuy.tsx';
import ProductCard from '~/components/ProductCard.astro';
import { getProduct, hasBackend } from '~/lib/products';
import { business, whatsappNumber } from '~/lib/business';
import { productLd, breadcrumbLd, trunc } from '~/lib/seo';
import { sanitizeHtml } from '~/lib/sanitize';
import { RESERVED_HANDLES, zar } from '~/lib/format';
import { u } from '~/lib/url';

const { handle } = Astro.params;
if (!handle || RESERVED_HANDLES.includes(handle)) return Astro.rewrite(u('/404'));
const { product: p, related, categories, error } = await getProduct(handle);
if (error) Astro.response.headers.set('Cache-Control', 'no-store');
if (!p) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  return Astro.rewrite(u('/404'));
}
const cat = categories.find((c) => c.handle === p.categories.find((h) => categories.find((x) => x.handle === h)?.parent) ) ?? categories.find((c) => c.handle === p.categories[0]);
const parentCat = cat?.parent ? categories.find((c) => c.handle === cat.parent) : null;
const html = sanitizeHtml(p.descriptionHtml);
const paras = p.description.split(/\n{2,}/).map((s) => s.trim()).filter(Boolean);
const desc = trunc(paras[0] ?? `${p.title} from Noord Karavane, caravan specialists in Pretoria North.`);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Shop', path: u('/') }, ...(parentCat ? [{ name: parentCat.name, path: u(`/category/${parentCat.handle}/`) }] : []), ...(cat ? [{ name: cat.name, path: u(`/category/${cat.handle}/`) }] : []), { name: p.title, path: u(`/${p.handle}/`) }];
const b = business;
const wa = whatsappNumber();
---
<Base title={p.title} description={desc} path={u(`/${p.handle}/`)} image={p.images[0]?.src} ogType="product" jsonld={[productLd(p), breadcrumbLd(crumbs)]} floatingChat={false}>
  <div class="rail" aria-hidden="true"></div>
  <article class="wrap pb-12 pt-6">
    <nav aria-label="Breadcrumb" class="mb-6 text-[0.92rem]">
      <ol class="flex flex-wrap gap-x-2">
        {crumbs.slice(1).map((c, i, a) => <li>{i < a.length - 1 ? <><a href={c.path}>{c.name}</a> <span aria-hidden="true">/</span></> : <span aria-current="page" class="text-muted">{c.name}</span>}</li>)}
      </ol>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-14">
      <div class="lg:sticky lg:top-24 lg:self-start" data-gallery>
        <div class="relative border border-ink-3 bg-paper-3">
          {p.images.length ? (
            <img data-main src={p.images[0].src} alt={p.images[0].alt} width="1000" height="1000" fetchpriority="high" class="aspect-square w-full object-contain" />
          ) : <div class="grid aspect-square place-items-center"><span class="font-display text-3xl">Photo soon</span></div>}
        </div>
        {p.images.length > 1 && (
          <ul class="mt-3 grid grid-cols-5 gap-2" aria-label="More photos">
            {p.images.map((im, i) => (
              <li><button type="button" data-thumb data-src={im.src} data-alt={im.alt} aria-label={`Photo ${i + 1} of ${p.images.length}`} aria-pressed={i === 0 ? 'true' : 'false'} class="block w-full border-2 border-transparent bg-paper-3 aria-pressed:border-wine"><img src={im.src} alt="" width="160" height="160" loading="lazy" class="aspect-square w-full object-contain" /></button></li>
            ))}
          </ul>
        )}
      </div>

      <div>
        {cat && <p class="mb-3"><a class="badge no-underline hover:bg-wine hover:text-paper" href={u(`/category/${cat.handle}/`)}>{cat.name}</a></p>}
        <h1 class="display text-[clamp(2.4rem,6vw,4.2rem)]">{p.title}</h1>
        <div class="mt-6">
          <ProductBuy client:load handle={p.handle} title={p.title} options={p.options} variants={p.variants.map((v) => ({ id: v.id, sku: v.sku, price: v.price, options: v.options }))} freeShipping={b.shipping.free_shipping_threshold_zar} live={hasBackend()} quote={p.freightQuote} />
          {wa && (
            <a href={`https://wa.me/${wa}?text=${encodeURIComponent(`Hi Noord Karavane! A question about ${p.title}: `)}`} target="_blank" rel="noopener" class="mt-1 inline-flex min-h-11 items-center gap-2 text-[0.95rem]">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88Zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z"/></svg>
              Questions? WhatsApp the workshop
            </a>
          )}
        </div>

        {(html || paras.length > 0) && (
          <div class="prose-nk mt-8 border-t border-ink-3 pt-6">
            {html ? <Fragment set:html={html} /> : paras.map((t) => <p>{t}</p>)}
          </div>
        )}

        <ul class="mt-8 grid gap-3 border-t border-ink-3 pt-6 text-[0.98rem]">
          <li class="flex gap-3"><span class="w-24 shrink-0 text-[0.82rem] font-semibold uppercase tracking-[0.08em] text-muted">Pay</span><span><strong>EFT, explained simply.</strong> Place your order and we show you our banking details and your reference. Pay within {b.eft_payment_window_hours} hours and we get it ready. <a href={u('/how-to-order')}>How it works</a>.</span></li>
          <li class="flex gap-3"><span class="w-24 shrink-0 text-[0.82rem] font-semibold uppercase tracking-[0.08em] text-muted">Get it</span><span>Courier from {zar(b.shipping.tcg_bands[0].price_zar)} by parcel size, small parcels to a Pudo locker, free over {zar(b.shipping.free_shipping_threshold_zar)}, or <strong>collect free</strong> from our Pretoria North workshop. <a href={u('/shipping')}>Delivery details</a>.</span></li>
          <li class="flex gap-3"><span class="w-24 shrink-0 text-[0.82rem] font-semibold uppercase tracking-[0.08em] text-muted">Fitting</span><span>We can fit it at the workshop. <a href={u('/contact')}>Ask us</a>. <a href={u('/legal/returns')}>Returns and refunds</a>.</span></li>
        </ul>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="band-ink section" aria-labelledby="rel-title">
      <div class="wrap">
        <h2 id="rel-title" class="display text-[clamp(1.8rem,4vw,2.8rem)]">You might also need</h2>
        <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4 lg:gap-x-6">
          {related.map((r) => <li><ProductCard product={r} /></li>)}
        </ul>
      </div>
    </section>
  )}
  <script>
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
      const main = g.querySelector<HTMLImageElement>('[data-main]');
      g.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((t) =>
        t.addEventListener('click', () => {
          if (!main) return;
          main.src = t.dataset.src!; main.alt = t.dataset.alt || '';
          g.querySelectorAll('[data-thumb]').forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
        }));
    });
  </script>
</Base>
