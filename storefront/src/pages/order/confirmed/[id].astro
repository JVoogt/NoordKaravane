---
import Base from '~/layouts/Base.astro';
import { business } from '~/lib/business';
import { getSdk, hasBackend } from '~/lib/products';
import { zar } from '~/lib/format';
import { u } from '~/lib/url';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const { id } = Astro.params;
if (!id || !/^[a-z0-9_]{6,64}$/i.test(id)) return Astro.rewrite(u('/404'));
const b = business;

let order: any = null;
if (hasBackend()) {
  try {
    const r = await getSdk().store.order.retrieve(id, { fields: '+display_id,+email,+total,+currency_code,*items,*shipping_methods,*payment_collection,*payment_collection.payment_sessions' } as any);
    order = (r as any).order;
  } catch (e) { console.warn('[order] could not retrieve', id, (e as Error).message); }
}
const display = order?.display_id as number | undefined;
const ref = display != null ? `NK${display}` : '';
const providers: string[] = (order?.payment_collection?.payment_sessions ?? []).map((s: any) => s.provider_id);
const isEft = !providers.length || providers.includes('pp_eft_eft');
const methodName: string = (order?.shipping_methods ?? [])[0]?.name || '';
const pudo = /pudo/i.test(methodName);
const collect = /collect from the workshop/i.test(methodName);
const rows: [string, string][] = [
  ['Account name', b.bank.account_name], ['Bank', b.bank.bank_name], ['Account number', b.bank.account_number],
  ['Branch code', b.bank.branch_code], ['Account type', b.bank.account_type],
];
---
<Base title="Order confirmed" description="Your Noord Karavane order is confirmed." path={u(`/order/confirmed/${id}`)} noindex floatingChat={false}>
  <div class="rail" aria-hidden="true"></div>
  <div class="wrap wrap-narrow pb-16 pt-12" data-order-id={id}>
    <h1 class="display text-[clamp(3rem,9vw,5.5rem)]">Order <span class="text-wine">confirmed.</span></h1>
    <p class="mt-3 text-[1.1rem]">
      Thank you for your order.
      {order?.email ? <>We have emailed the details to <strong>{order.email}</strong>.</> : <>We have emailed the details to the address you gave us.</>}
    </p>

    <p class="mt-6 text-[1.05rem]">Order <strong data-order-ref>{ref || '...'}</strong>{order?.total != null && <> &middot; {zar(order.total)}</>}</p>

    {isEft ? (
      <section class="band-ink relative mt-8 border border-ink-3 p-6 sm:p-8" aria-labelledby="eft-title">
        <h2 id="eft-title" class="display text-[clamp(1.8rem,4.5vw,2.6rem)]">One step left: pay by EFT</h2>
        <p class="mt-3 max-w-[56ch] text-muted">Pay from your banking app within <strong class="text-ink">{b.eft_payment_window_hours} hours</strong>. Once the money lands we get your order ready. Unpaid orders are cancelled automatically after {b.eft_payment_window_hours} hours.</p>
        <dl class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {rows.map(([k, v]) => <div><dt class="label text-muted">{k}</dt><dd class="mt-0.5 text-[1.05rem] font-medium">{v}</dd></div>)}
        </dl>
        <div class="relative mt-8 border-2 border-wine p-5">
          <p class="label text-wine-lit">Use this as your payment reference</p>
          <p class="display mt-1 text-[clamp(2.6rem,8vw,3.8rem)]" data-order-ref>{ref || '...'}</p>
          <p class="mt-1 text-[0.92rem] text-muted">Exactly as shown, so we can match your payment.</p>
          <button type="button" class="btn btn--ghost mt-4" data-copy-ref>Copy reference</button>
        </div>
        <p class="hint mt-5">Paying from a different bank can take up to a business day to reflect. Send proof of payment to <a href={`mailto:${b.email_orders}`}>{b.email_orders}</a> to speed things up.</p>
      </section>
    ) : (
      <section class="mt-8 border border-ink-3 bg-paper-2 p-6"><h2 class="display text-[1.8rem]">Payment received at Payfast</h2><p class="mt-2">We will confirm by email as soon as it clears.</p></section>
    )}

    <section class="mt-10" aria-labelledby="next-title">
      <h2 id="next-title" class="display text-[1.8rem]">What happens next</h2>
      <ol class="prose-nk mt-3">
        <li><strong>We confirm your payment.</strong> You get an email the moment it is captured.</li>
        <li><strong>We get your order ready.</strong> Allow {b.production_lead_time_days}.</li>
        <li><strong>{collect ? 'You collect it.' : 'It ships.'}</strong> {collect ? 'We contact you when it is ready at 252 General Beyers Street, Pretoria North (Mon to Thu 08:00 to 16:00, Fri 08:00 to 14:00). Please bring your order reference.' : pudo ? 'To your Pudo locker, with a tracking link by email.' : 'By The Courier Guy or Pudo locker, with a tracking link by email.'}</li>
      </ol>
      <div class="mt-6 flex flex-wrap gap-3"><a class="btn" href={u('/')}>Keep shopping</a><a class="btn btn--ghost" href={u('/contact')}>Need help?</a></div>
    </section>
    <noscript><p class="hint mt-6">Tip: your reference is the order number shown above, with NK in front.</p></noscript>
  </div>
  <script>
    // Fill the reference from this tab's checkout when the server could not load the order, fire the purchase event once, and wire the copy button.
    const root = document.querySelector<HTMLElement>('[data-order-id]');
    let last: any = null;
    try { last = JSON.parse(sessionStorage.getItem('nk_last_order') || 'null'); } catch { /* storage blocked */ }
    if (root && last && last.id === root.dataset.orderId) {
      const ref = 'NK' + last.display_id;
      document.querySelectorAll('[data-order-ref]').forEach((el) => { if (!el.textContent || el.textContent === '...') el.textContent = ref; });
      window.nkTrack?.('purchase', { transaction_id: ref, currency: last.currency || 'ZAR', value: last.total, items: last.items, meta_event_id: last.meta_event_id });
      try { sessionStorage.removeItem('nk_last_order'); } catch { /* ignore */ }
    }
    document.querySelector<HTMLButtonElement>('[data-copy-ref]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const text = document.querySelector('[data-order-ref]')?.textContent?.trim() || '';
      try { await navigator.clipboard.writeText(text); btn.textContent = 'Copied'; } catch { btn.textContent = 'Select and copy it above'; }
      setTimeout(() => { btn.textContent = 'Copy reference'; }, 2500);
    });
  </script>
</Base>
