{
  "name": "nkshop-storefront",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "build": "node scripts/guard.mjs && astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/guard.mjs",
    "guard": "node scripts/guard.mjs",
    "test": "node --test src/lib/turnstile.test.ts src/lib/quote.test.ts src/lib/promo.test.ts src/lib/cart-load.test.ts src/lib/brands.test.ts src/lib/cookie-path.test.ts src/lib/sanitize.test.ts src/lib/fill.test.ts src/lib/business-display.test.ts src/lib/woo-redirects.test.ts src/lib/swr.test.ts src/lib/paging.test.ts scripts/guard.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/preact": "^4.1.3",
    "@fontsource/barlow": "^5.2.0",
    "@fontsource/bebas-neue": "^5.2.0",
    "@fontsource/montserrat": "^5.3.0",
    "@medusajs/js-sdk": "^2.22.2",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^5.18.2",
    "marked": "^18.1.3",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.4",
    "vanilla-cookieconsent": "^3.2.1"
  }
}
