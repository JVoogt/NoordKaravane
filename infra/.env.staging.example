# Staging overrides. Copy to .env.staging (chmod 600) on the Pi. Same variable names as .env.example;
# ONLY the values below differ. Everything not listed here must still be present (copy the rest from .env
# and use staging-safe values: Payfast sandbox, a throwaway Redis/Postgres password, test SMTP or a sink).
COMPOSE_PROJECT_NAME=noordkaravane-staging
IMAGE_TAG=staging
BIND_IP=192.168.0.120
PORT_WEB=8552
PORT_API=8553
BACKUPS_DIR=./backups-staging

POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_hex
POSTGRES_DB=medusa_staging
REDIS_PASSWORD=CHANGE_ME_hex
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

JWT_SECRET=CHANGE_ME_different_from_prod
COOKIE_SECRET=CHANGE_ME_different_from_prod

SITE_URL=https://staging.noordkaravane.co.za
PUBLIC_SITE_URL=https://staging.noordkaravane.co.za
PUBLIC_MEDUSA_URL=https://staging-api.noordkaravane.co.za
MEDUSA_BACKEND_URL=https://staging-api.noordkaravane.co.za
ADMIN_BACKEND_URL=https://staging-api.noordkaravane.co.za
STORE_CORS=https://staging.noordkaravane.co.za
ADMIN_CORS=https://staging-api.noordkaravane.co.za
AUTH_CORS=https://staging.noordkaravane.co.za,https://staging-api.noordkaravane.co.za

# Staging must NOT purge production's Cloudflare cache or fire real Meta events
CF_ZONE_ID=
CF_API_TOKEN=
META_PIXEL_ID=
META_CAPI_TOKEN=
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
PAYFAST_ENABLED=false
PAYFAST_SANDBOX=true
# Use a SEPARATE R2 bucket (or key prefix) for staging, or leave S3_BUCKET empty to use local file storage
S3_BUCKET=
