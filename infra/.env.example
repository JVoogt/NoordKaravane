# Noord Karavane: environment for docker-compose.yml.
# Copy to infra/.env ON THE PI (`make env-init`), chmod 600, never commit. Compose reads it from the infra/ folder.
# Values containing $ # or spaces need quoting; generate secrets as hex so you never have to:
#     openssl rand -hex 32
# ${VAR} references inside this file are expanded by Docker Compose.
# Tunnel variables from the earlier design are gone: Traefik + Let's Encrypt fronts everything.

# =============================================================================
# Deployment shape (infra only)
# =============================================================================
# Host IP the published ports bind to (the Pi's LAN address that Traefik routes to)
BIND_IP=192.168.0.120
PORT_WEB=8550            # storefront  -> noordkaravane.co.za
PORT_API=8551            # medusa      -> api. / admin.
TZ=Africa/Johannesburg
# IMAGE_TAG is set by `make build` / `make rollback` (noordkaravane-*:<git-sha>, :latest, :prev). Leave unset.
# IMAGE_TAG=latest
# Use backend/Dockerfile or storefront/Dockerfile instead of infra/docker/*.Dockerfile (paths are relative to the build context)
# BACKEND_DOCKERFILE=Dockerfile
# STOREFRONT_DOCKERFILE=Dockerfile
# Heap caps (container memory limits are in docker-compose.yml)
# MEDUSA_NODE_OPTIONS=--max-old-space-size=640
# STOREFRONT_NODE_OPTIONS=--max-old-space-size=256

# =============================================================================
# Postgres + Redis (internal network only, never published)
# =============================================================================
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=medusa
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24
# pg_dump schedule (local time) and how many dumps to keep in ./backups
# 01:30 so the dump exists before the central dockpi-backup runs (its cron is 0 2 * * *)
PGDUMP_AT=01:30
PGDUMP_KEEP=7
# BACKUPS_DIR=./backups

# =============================================================================
# CONTRACTS.md shared variables
# =============================================================================
# --- Medusa core ---
# sslmode=disable: Postgres is on a private docker network without TLS; Medusa defaults to SSL in production otherwise.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
COOKIE_SECRET=CHANGE_ME_openssl_rand_hex_32
# Browser origins allowed to call the store API / auth
STORE_CORS=https://noordkaravane.co.za
# Admin origin. The admin SPA is built same-origin against the admin host (see ADMIN_BACKEND_URL below).
ADMIN_CORS=https://admin.noordkaravane.co.za
AUTH_CORS=https://noordkaravane.co.za,https://admin.noordkaravane.co.za
# Public URL of the store API (Payfast notify URL, emails). The api. host.
MEDUSA_BACKEND_URL=https://api.noordkaravane.co.za
# Set per service by docker-compose.yml (server=server, worker=worker, migrate=shared). Do not set here.
# MEDUSA_WORKER_MODE=shared
# DISABLE_MEDUSA_ADMIN=false
# Build-time only (infra): API base baked into the admin bundle. Same-origin admin host so admin API calls stay behind Cloudflare Access.
ADMIN_BACKEND_URL=https://admin.noordkaravane.co.za
SITE_URL=https://noordkaravane.co.za

# --- Files: Cloudflare R2 via the Medusa S3 provider (leave S3_BUCKET empty to use local disk) ---
# S3_FILE_URL is the public base URL served by the R2 custom domain
S3_FILE_URL=https://cdn.noordkaravane.co.za
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
# https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# --- Email: Brevo SMTP relay ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. Noord Karavane <orders@noordkaravane.co.za>  (the domain must be authenticated in Brevo, configure in the Cloudflare dashboard)
SMTP_FROM=

# --- Cloudflare cache purge (token scope: Zone > Cache Purge > Purge, this zone only). Empty = purge is skipped ---
CF_ZONE_ID=
CF_API_TOKEN=

# --- Meta (Conversions API; server side). Empty = disabled ---
META_PIXEL_ID=
META_CAPI_TOKEN=
# Use only while testing in Events Manager > Test events; remove for live
META_TEST_EVENT_CODE=

# --- Payfast (scaffold; module registers only when PAYFAST_ENABLED=true) ---
PAYFAST_ENABLED=false
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Sandbox testing only (skips the Payfast source-IP check on the ITN hook). Never true in production.
PAYFAST_SKIP_IP_CHECK=false

# --- Storefront (PUBLIC_* are baked in at BUILD time: rebuild the storefront image after changing them) ---
PUBLIC_MEDUSA_URL=https://api.noordkaravane.co.za
# From Medusa Admin > Settings > Publishable API Keys (or the seed output). Needed before building the storefront.
PUBLIC_MEDUSA_PUBLISHABLE_KEY=
PUBLIC_SITE_URL=https://noordkaravane.co.za
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
# Cloudflare Turnstile: site key is public, secret is server side only
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Contact form recipient (storefront). Empty = business.json email_general
CONTACT_TO=

# Brevo REST API (storefront: newsletter signup + contact form). Brevo > SMTP & API > API Keys.
# The Pi's public IP must be on Brevo's authorised IPs list.
BREVO_API_KEY=
BREVO_LIST_ID=4
